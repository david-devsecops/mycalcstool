{
  "name": "mycalcstool",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run update:ads-txt",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "update:ads-txt": "node ./scripts/update-ads-txt.mjs",
    "insights:test": "node --test scripts/insights/*.test.mjs",
    "insights:collect:naver": "node scripts/insights/collect-naver.mjs",
    "insights:pipeline": "node scripts/insights/run-local-pipeline.mjs",
    "insights:analyze": "node scripts/insights/analyze-issues.mjs",
    "insights:generate:articles": "node scripts/insights/generate-article-candidates.mjs",
    "insights:generate:calculator-backlog": "node scripts/insights/generate-calculator-backlog.mjs",
    "insights:publish:plan": "node scripts/insights/publish-candidates.mjs",
    "insights:publish:articles": "node scripts/insights/publish-articles.mjs",
    "insights:metrics:import": "node scripts/insights/import-search-console-csv.mjs",
    "insights:metrics:import:ga4": "node scripts/insights/import-ga4-calculator-clicks.mjs",
    "insights:report": "node scripts/insights/report.mjs",
    "insights:scan:analytics-privacy": "node scripts/insights/scan-analytics-privacy.mjs",
    "insights:scan:secrets": "node scripts/insights/scan-secrets.mjs",
    "insights:verify:sitemap": "node scripts/insights/verify-sitemap.mjs",
    "verify:release": "node scripts/insights/verify-release.mjs"
  },
  "dependencies": {
    "astro": "^5.6.1",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "tailwindcss": "^3.4.17"
  }
}
