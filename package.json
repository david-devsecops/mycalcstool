    "insights:report": "node scripts/insights/report.mjs"
  },
  "dependencies": {
    "astro": "^5.6.1",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "tailwindcss": "^3.4.17"
