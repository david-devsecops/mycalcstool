---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import FAQ from './FAQ.astro';
import RelatedIssueArticles from './RelatedIssueArticles.astro';
import type { GrowthCalculatorPageData } from '../data/growth-calculators';

interface Props {
  page: GrowthCalculatorPageData;
}

const { page } = Astro.props;
const siteUrl = 'https://mycalcstool.com';
const path = page.lang === 'ko' ? `/${page.slug}/` : `/en/${page.slug}/`;
const canonicalUrl = `${siteUrl}${path}`;
const koPath = `/${page.slug}/`;
const enPath = `/en/${page.slug}/`;
const relatedItems = page.related.filter((item) => item.href !== path);
const langLabel = page.lang === 'ko' ? {
  home: '홈',
  calculate: '계산하기',
  inputs: '입력값',
  results: '계산 결과',
  answerTitle: '바로 계산하면 무엇을 알 수 있나요?',
  formulaTitle: '계산 공식',
  exampleTitle: '예시',
  mistakesTitle: '자주 하는 실수',
  sourcesTitle: '가격·기준 확인',
  disclaimerTitle: '주의사항',
  relatedTitle: '관련 계산기',
  sourceIntro: '가격과 정책은 바뀔 수 있으므로 실제 사용 전 공식 자료를 확인하세요.',
  checklistTitle: '입력 전 확인할 점',
  interpretationTitle: '결과 해석 순서',
  reviewTitle: '검수·업데이트 기준',
  reviewDate: '2026년 8월 6일',
  primaryResultPrefix: '가장 먼저 볼 값은',
  secondaryResultPrefix: '함께 확인할 보조 값은',
  useCasesTitle: '이 계산기를 쓰기 좋은 상황',
  notIncludedTitle: '포함하지 않는 항목',
} : {
  home: 'Home',
  calculate: 'Calculate',
  inputs: 'Inputs',
  results: 'Results',
  answerTitle: 'What does this calculator answer?',
  formulaTitle: 'Formula',
  exampleTitle: 'Example',
  mistakesTitle: 'Common mistakes',
  sourcesTitle: 'Sources and pricing',
  disclaimerTitle: 'Important note',
  relatedTitle: 'Related calculators',
  sourceIntro: 'Prices and policies can change. Confirm official sources before budgeting.',
  checklistTitle: 'Before you enter values',
  interpretationTitle: 'How to read the result',
  reviewTitle: 'Review and update policy',
  reviewDate: 'August 6, 2026',
  primaryResultPrefix: 'Start with',
  secondaryResultPrefix: 'Then compare',
  useCasesTitle: 'Good use cases',
  notIncludedTitle: 'What is not included',
};

const fieldChecklist = page.fields.map((field) => {
  const unit = field.suffix.trim();
  if (page.lang === 'ko') {
    return unit
      ? `${field.label}은 ${unit} 단위를 맞춰 입력해야 결과가 왜곡되지 않습니다.`
      : `${field.label}은 실제로 계산하려는 문장이나 조건을 그대로 입력하세요.`;
  }

  return unit
    ? `Enter ${field.label.toLowerCase()} in ${unit} so the estimate uses the same unit throughout.`
    : `Enter the exact text or scenario you want to estimate for ${field.label.toLowerCase()}.`;
});

const resultGuide = page.resultLabels.map((label, index) => {
  if (page.lang === 'ko') {
    return index === 0
      ? `${langLabel.primaryResultPrefix} '${label}'입니다. 이 값이 현재 입력 조건의 핵심 판단 기준입니다.`
      : `${langLabel.secondaryResultPrefix} '${label}'입니다. 첫 번째 결과만 보지 말고 비용, 수량, 비율 변화를 함께 확인하세요.`;
  }

  return index === 0
    ? `${langLabel.primaryResultPrefix} '${label}'. This is the main output for the current assumptions.`
    : `${langLabel.secondaryResultPrefix} '${label}' so you do not judge the scenario from one number alone.`;
});

const scopeNotes = page.lang === 'ko'
  ? page.category === 'AI'
    ? {
      useCases: [
        '제품 출시 전 예상 요청 수와 평균 토큰 길이로 월 API 예산 범위를 잡을 때 유용합니다.',
        '프롬프트 길이, 출력 길이, 모델 단가를 바꿨을 때 비용 변화가 얼마나 큰지 비교할 수 있습니다.',
        '팀별 사용량을 같은 단가 기준으로 환산해 내부 예산 검토 자료를 만들 때 참고할 수 있습니다.',
      ],
      notIncluded: [
        '실시간 공식 가격 자동 반영, 캐시·배치 할인, 이미지·음성·검색·도구 호출 비용은 포함하지 않습니다.',
        '계정별 약정, 무료 크레딧, 세금, 환율, 결제 수수료는 별도로 확인해야 합니다.',
        '모델 품질, 지연시간, 실패율처럼 실제 운영 성능을 평가하지 않습니다.',
      ],
    }
    : {
      useCases: [
        '매수·매도 전후 평균 단가, 손익, 배당 현금흐름을 같은 입력 기준으로 비교할 때 유용합니다.',
        '가격, 수량, 기간, 수익률 가정을 바꿔 여러 투자 시나리오를 빠르게 검산할 수 있습니다.',
        '증권사 화면이나 개인 투자 기록에 나온 숫자가 대략 맞는지 확인하는 보조 도구로 쓸 수 있습니다.',
      ],
      notIncluded: [
        '실시간 시세, 호가, 증권사별 수수료, 세금, 환전 스프레드는 자동 반영하지 않습니다.',
        '종목 추천, 기업 가치평가, 미래 수익률 예측을 제공하지 않습니다.',
        '배당 변경, 거래 정지, 유동성, 환율 급변 같은 투자 위험을 계산하지 않습니다.',
      ],
    }
  : page.category === 'AI'
    ? {
      useCases: [
        'Estimate a monthly API budget before launch from expected calls, token length, and editable model prices.',
        'Compare how prompt length, output length, and provider pricing change the same workload cost.',
        'Translate team or product usage assumptions into a simple budget discussion before deeper testing.',
      ],
      notIncluded: [
        'Live provider pricing, caching discounts, batch discounts, image, audio, search, and tool-call charges are not included.',
        'Account-specific credits, negotiated pricing, taxes, currency conversion, and payment fees must be checked separately.',
        'Model quality, latency, retries, and failure rates are operational factors outside this calculator.',
      ],
    }
    : {
      useCases: [
        'Compare average cost, return, dividend income, or recurring investment scenarios before updating a spreadsheet.',
        'Change price, quantity, period, or return assumptions quickly and see which input drives the result.',
        'Use the output as a second check against broker statements or your own investment notes.',
      ],
      notIncluded: [
        'Live quotes, bid-ask spreads, broker fees, taxes, and currency conversion costs are not pulled automatically.',
        'The calculator does not recommend securities, value a business, or forecast future returns.',
        'Dividend cuts, trading halts, liquidity, FX shocks, and other investment risks are not modeled.',
      ],
    };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: page.h1,
    description: page.description,
    url: canonicalUrl,
    applicationCategory: page.category === 'AI' ? 'DeveloperApplication' : 'FinanceApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: page.lang === 'ko' ? 'KRW' : 'USD',
    },
    inLanguage: page.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: langLabel.home,
        item: `${siteUrl}${page.lang === 'ko' ? '/' : '/en/'}`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: page.h1,
        item: canonicalUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  keywords={page.keywords}
  canonicalUrl={canonicalUrl}
  lang={page.lang}
  jsonLd={jsonLd}
  hreflangKo={page.lang === 'en' ? koPath : undefined}
  hreflangEn={page.lang === 'ko' ? enPath : undefined}
>
  <nav class="text-sm text-gray-500 mb-3" aria-label="breadcrumb">
    <ol class="flex items-center gap-1 list-none p-0 flex-wrap">
      <li><a href={page.lang === 'ko' ? '/' : '/en/'} class="hover:text-primary-600 transition-colors">{langLabel.home}</a></li>
      <li aria-hidden="true" class="text-gray-300">/</li>
      <li class="text-gray-700 font-medium" aria-current="page">{page.h1}</li>
    </ol>
  </nav>

  <header class="mb-6">
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <span class="text-4xl" aria-hidden="true">{page.icon}</span>
      <span class="text-xs px-2.5 py-1 rounded-full border font-semibold bg-blue-50 text-blue-700 border-blue-200">{page.category}</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">{page.h1}</h1>
    <p class="text-gray-600 mt-3 leading-relaxed">{page.description}</p>
  </header>

  <AdSlot slot="top" format="horizontal" />

  <section class="card mb-6 border-primary-100 bg-primary-50" aria-labelledby="answer-title">
    <h2 id="answer-title" class="section-title">
      <span aria-hidden="true">⚡</span>
      {langLabel.answerTitle}
    </h2>
    <p class="text-gray-700 leading-relaxed">{page.answer}</p>
  </section>

  <section
    class="card mb-6"
    data-growth-calculator
    data-calculator-id={page.id}
    data-lang={page.lang}
    aria-labelledby="calculator-title"
  >
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 id="calculator-title" class="section-title mb-0">
        <span aria-hidden="true">🧮</span>
        {langLabel.inputs}
      </h2>
      <button type="button" class="btn-primary md:w-auto" data-calculate>{langLabel.calculate}</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      {page.fields.map((field) => (
        <label class={field.type === 'textarea' ? 'md:col-span-2 block' : 'block'}>
          <span class="block text-sm font-semibold text-gray-700 mb-2">{field.label}</span>
          {field.type === 'textarea' ? (
            <textarea
              data-field={field.id}
              class="input-field min-h-28 resize-y"
              rows="5"
            >{field.value}</textarea>
          ) : (
            <div class="flex items-center gap-3">
              <input
                data-field={field.id}
                type="number"
                class="input-field flex-1"
                value={field.value}
                min={field.min}
                max={field.max}
                step={field.step}
                inputmode="decimal"
              />
              {field.suffix && <span class="text-sm text-gray-500 font-medium whitespace-nowrap">{field.suffix}</span>}
            </div>
          )}
        </label>
      ))}
    </div>

    <section aria-labelledby="results-title">
      <h3 id="results-title" class="text-lg font-bold text-gray-800 mb-3">{langLabel.results}</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {page.resultLabels.map((label, index) => (
          <div class="rounded-xl border border-gray-200 bg-white p-4">
            <p class="text-sm text-gray-500">{label}</p>
            <p class="mt-2 text-2xl font-bold text-primary-700 tabular-nums" data-result={index}>-</p>
          </div>
        ))}
      </div>
    </section>
  </section>

  <section class="card mb-6" aria-labelledby="checklist-title">
    <h2 id="checklist-title" class="section-title">
      <span aria-hidden="true">✅</span>
      {langLabel.checklistTitle}
    </h2>
    <ul class="list-disc pl-5 space-y-2 text-gray-700 leading-relaxed">
      {fieldChecklist.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="card mb-6" aria-labelledby="interpretation-title">
    <h2 id="interpretation-title" class="section-title">
      <span aria-hidden="true">🔍</span>
      {langLabel.interpretationTitle}
    </h2>
    <ol class="list-decimal pl-5 space-y-2 text-gray-700 leading-relaxed">
      {resultGuide.map((item) => <li>{item}</li>)}
    </ol>
  </section>

  <section class="card mb-6" aria-labelledby="use-cases-title">
    <h2 id="use-cases-title" class="section-title">
      <span aria-hidden="true">🧭</span>
      {langLabel.useCasesTitle}
    </h2>
    <ul class="list-disc pl-5 space-y-2 text-gray-700 leading-relaxed">
      {scopeNotes.useCases.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="card mb-6" aria-labelledby="formula-title">
    <h2 id="formula-title" class="section-title">
      <span aria-hidden="true">📌</span>
      {langLabel.formulaTitle}
    </h2>
    <p class="rounded-xl bg-gray-50 border border-gray-100 p-4 text-gray-800 font-medium leading-relaxed">{page.formula}</p>
  </section>

  <section class="card mb-6" aria-labelledby="example-title">
    <h2 id="example-title" class="section-title">
      <span aria-hidden="true">📝</span>
      {langLabel.exampleTitle}
    </h2>
    <p class="text-gray-700 leading-relaxed">{page.example}</p>
  </section>

  <section class="card mb-6" aria-labelledby="not-included-title">
    <h2 id="not-included-title" class="section-title">
      <span aria-hidden="true">🚫</span>
      {langLabel.notIncludedTitle}
    </h2>
    <ul class="list-disc pl-5 space-y-2 text-gray-700 leading-relaxed">
      {scopeNotes.notIncluded.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="card mb-6" aria-labelledby="mistakes-title">
    <h2 id="mistakes-title" class="section-title">
      <span aria-hidden="true">⚠️</span>
      {langLabel.mistakesTitle}
    </h2>
    <ul class="list-disc pl-5 space-y-2 text-gray-700 leading-relaxed">
      {page.mistakes.map((mistake) => <li>{mistake}</li>)}
    </ul>
  </section>

  {page.sourceLinks && page.sourceLinks.length > 0 && (
    <section class="card mb-6" aria-labelledby="sources-title">
      <h2 id="sources-title" class="section-title">
        <span aria-hidden="true">🔎</span>
        {langLabel.sourcesTitle}
      </h2>
      <p class="text-gray-700 leading-relaxed mb-3">{langLabel.sourceIntro}</p>
      <ul class="list-disc pl-5 space-y-2">
        {page.sourceLinks.map((source) => (
          <li>
            <a href={source.href} class="font-semibold text-primary-600 hover:underline" target="_blank" rel="noopener noreferrer">{source.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="card mb-6 bg-amber-50 border-amber-100" aria-labelledby="disclaimer-title">
    <h2 id="disclaimer-title" class="section-title">
      <span aria-hidden="true">🛡️</span>
      {langLabel.disclaimerTitle}
    </h2>
    <p class="text-sm text-amber-900 leading-relaxed">{page.disclaimer}</p>
  </section>

  <section class="card mb-6" aria-labelledby="review-title">
    <h2 id="review-title" class="section-title">
      <span aria-hidden="true">🧾</span>
      {langLabel.reviewTitle}
    </h2>
    {page.lang === 'ko' ? (
      <div class="space-y-3 text-sm text-gray-700 leading-relaxed">
        <p>
          이 페이지는 {langLabel.reviewDate}에 계산 공식, 기본 입력값, FAQ, 관련 계산기 링크를 점검했습니다.
          투자·AI 비용 계산기는 실시간 시세나 계정별 요금을 직접 가져오지 않으므로 사용자가 최신 값을 입력해야 합니다.
        </p>
        <p>
          공식 출처가 있는 항목은 출처 링크를 함께 제공하고, 출처가 바뀌면 계산식과 안내 문구를 같이 수정합니다.
          오류나 오래된 기준을 발견하면 <a href="/contact" class="font-semibold text-primary-600 hover:underline">문의 페이지</a>로 URL과 근거 자료를 보내주세요.
        </p>
      </div>
    ) : (
      <div class="space-y-3 text-sm text-gray-700 leading-relaxed">
        <p>
          This page was reviewed on {langLabel.reviewDate} for formula wording, default inputs, FAQ coverage, and related calculator links.
          Investing and AI cost calculators do not pull live market prices or account-specific pricing, so you should enter the latest values yourself.
        </p>
        <p>
          When official sources are relevant, source links are provided on the page. If a formula, rate, or source is outdated, send the page URL and supporting reference through the <a href="/en/contact" class="font-semibold text-primary-600 hover:underline">contact page</a>.
        </p>
      </div>
    )}
  </section>

  <FAQ items={page.faqs} title={page.lang === 'ko' ? '자주 묻는 질문' : 'Frequently Asked Questions'} />

  <RelatedIssueArticles calculatorId={page.slug} language={page.lang} />

  <section class="card mt-6" aria-labelledby="related-title">
    <h2 id="related-title" class="section-title">
      <span aria-hidden="true">🔗</span>
      {langLabel.relatedTitle}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {relatedItems.map((item) => (
        <a href={item.href} class="rounded-xl border border-gray-200 p-4 hover:border-primary-300 hover:bg-primary-50 transition-colors no-underline">
          <p class="font-semibold text-gray-800">{item.label}</p>
          <p class="text-sm text-gray-500 mt-1 leading-relaxed">{item.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <script>
    (function () {
      var root = document.querySelector('[data-growth-calculator]');
      if (!root) return;

      var calculatorId = root.getAttribute('data-calculator-id') || '';
      var lang = root.getAttribute('data-lang') || 'ko';
      var locale = lang === 'ko' ? 'ko-KR' : 'en-US';

      function number(value, digits) {
        var safe = Number.isFinite(value) ? value : 0;
        return new Intl.NumberFormat(locale, {
          maximumFractionDigits: digits === undefined ? 2 : digits,
        }).format(safe);
      }

      function money(value) {
        var safe = Number.isFinite(value) ? value : 0;
        var currency = lang === 'ko' ? 'KRW' : 'USD';
        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency: currency,
          maximumFractionDigits: lang === 'ko' ? 0 : 2,
        }).format(safe);
      }

      function percent(value) {
        return number(value, 2) + '%';
      }

      function values() {
        var output = {};
        root.querySelectorAll('[data-field]').forEach(function (field) {
          var key = field.getAttribute('data-field');
          if (!key) return;
          if (field instanceof HTMLTextAreaElement) {
            output[key] = field.value || '';
            return;
          }
          if (field instanceof HTMLInputElement) {
            var parsed = Number(field.value);
            output[key] = Number.isFinite(parsed) ? parsed : 0;
          }
        });
        return output;
      }

      function cost(inputTokens, outputTokens, requests, inputPrice, outputPrice) {
        var inputCost = inputTokens * requests / 1000000 * inputPrice;
        var outputCost = outputTokens * requests / 1000000 * outputPrice;
        return { inputCost: inputCost, outputCost: outputCost, total: inputCost + outputCost };
      }

      function formatCost(value) {
        return '$' + number(value, 4);
      }

      var calculators = {
        'stock-average': function (v) {
          var totalShares = v.currentShares + v.buyShares;
          var totalCost = v.currentShares * v.currentPrice + v.buyShares * v.buyPrice;
          var average = totalShares > 0 ? totalCost / totalShares : 0;
          return [money(average), number(totalShares, 4), money(totalCost)];
        },
        'stock-averaging-down': function (v) {
          var totalShares = v.currentShares + v.buyShares;
          var totalCost = v.currentShares * v.currentPrice + v.buyShares * v.buyPrice;
          var average = totalShares > 0 ? totalCost / totalShares : 0;
          var rebound = v.buyPrice > 0 ? (average - v.buyPrice) / v.buyPrice * 100 : 0;
          return [money(average), money(totalCost), percent(rebound)];
        },
        'stock-return': function (v) {
          var purchase = v.buyPrice * v.shares;
          var sale = v.sellPrice * v.shares;
          var profit = sale - purchase - v.costs;
          var returnRate = purchase > 0 ? profit / purchase * 100 : 0;
          return [money(profit), percent(returnRate), money(sale)];
        },
        'dividend': function (v) {
          var annual = v.shares * v.dividendPerShare;
          var afterTax = annual * (1 - v.taxRate / 100);
          return [money(annual), money(afterTax), money(afterTax / 12)];
        },
        'dividend-yield': function (v) {
          var yieldRate = v.stockPrice > 0 ? v.annualDividend / v.stockPrice * 100 : 0;
          var shares = v.stockPrice > 0 ? Math.floor(v.investment / v.stockPrice) : 0;
          return [percent(yieldRate), number(shares, 0), money(shares * v.annualDividend)];
        },
        'foreign-stock-return': function (v) {
          var buyLocal = v.buyPrice * v.shares * v.buyFx;
          var sellLocal = v.sellPrice * v.shares * v.sellFx;
          var profit = sellLocal - buyLocal;
          var returnRate = buyLocal > 0 ? profit / buyLocal * 100 : 0;
          var fxOnly = v.buyPrice * v.shares * (v.sellFx - v.buyFx);
          var localUnit = lang === 'ko' ? '' : ' local';
          return [lang === 'ko' ? money(profit) : number(profit, 2) + localUnit, percent(returnRate), lang === 'ko' ? money(fxOnly) : number(fxOnly, 2) + localUnit];
        },
        'etf-investment': function (v) {
          var months = Math.max(0, Math.round(v.years * 12));
          var monthlyRate = Math.pow(1 + v.annualReturn / 100, 1 / 12) - 1;
          var initialFuture = v.initialAmount * Math.pow(1 + monthlyRate, months);
          var contributionFuture = monthlyRate === 0
            ? v.monthlyContribution * months
            : v.monthlyContribution * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate);
          var future = initialFuture + contributionFuture;
          var contributed = v.initialAmount + v.monthlyContribution * months;
          return [money(future), money(contributed), money(future - contributed)];
        },
        'ai-token': function (v) {
          var text = String(v.promptText || '');
          var chars = text.length;
          var words = text.trim() ? text.trim().split(/\s+/).length : 0;
          var hasKorean = /[ㄱ-ㅎㅏ-ㅣ가-힣]/.test(text);
          var inputTokens = Math.ceil(hasKorean ? chars / 2 : chars / 4);
          var totalTokens = inputTokens + v.outputTokens;
          return [number(inputTokens, 0), number(totalTokens, 0), number(words, 0)];
        },
        'chatgpt-api-cost': function (v) {
          var c = cost(v.inputTokens, v.outputTokens, v.requests, v.inputPrice, v.outputPrice);
          return [formatCost(c.total), formatCost(c.inputCost), formatCost(c.outputCost)];
        },
        'ai-model-cost-comparison': function (v) {
          var gpt = cost(v.inputTokens, v.outputTokens, v.requests, v.gptInputPrice, v.gptOutputPrice);
          var claude = cost(v.inputTokens, v.outputTokens, v.requests, v.claudeInputPrice, v.claudeOutputPrice);
          var gemini = cost(v.inputTokens, v.outputTokens, v.requests, v.geminiInputPrice, v.geminiOutputPrice);
          return [formatCost(gpt.total), formatCost(claude.total), formatCost(gemini.total)];
        },
      };

      function calculate() {
        var fn = calculators[calculatorId];
        if (!fn) return;
        var results = fn(values());
        root.querySelectorAll('[data-result]').forEach(function (resultEl) {
          var index = Number(resultEl.getAttribute('data-result'));
          resultEl.textContent = results[index] || '-';
        });
      }

      root.querySelector('[data-calculate]')?.addEventListener('click', calculate);
      root.querySelectorAll('[data-field]').forEach(function (field) {
        field.addEventListener('input', calculate);
      });
      calculate();
    })();
  </script>
</BaseLayout>
