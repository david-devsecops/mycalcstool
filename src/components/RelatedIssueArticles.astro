---
import { getArticlesForCalculator } from '../data/articles.mjs';

interface Props {
  calculatorId: string;
  language?: string;
  title?: string;
}

const { calculatorId, language = 'ko', title = '관련 금융·생활 정보' } = Astro.props;
const articles = getArticlesForCalculator(calculatorId, language);
---

{articles.length > 0 && (
  <section class="card mt-6" aria-labelledby={`${calculatorId}-related-articles`}>
    <h2 class="section-title" id={`${calculatorId}-related-articles`}>
      <span aria-hidden="true">📌</span>
      {title}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {articles.map((article) => (
        <a href={`/articles/${article.slug}/`} class="rounded-xl border border-gray-200 p-4 hover:border-primary-300 hover:bg-primary-50 transition-colors">
          <p class="text-xs font-semibold text-primary-600">{article.category}</p>
          <p class="mt-1 font-semibold text-gray-800">{article.title}</p>
          <p class="mt-1 text-sm text-gray-500">{article.description}</p>
        </a>
      ))}
    </div>
  </section>
)}
