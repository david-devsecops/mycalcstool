---
import { adProvider, adsenseClient, gaMeasurementId } from '../data/site-meta';

const loadAdsense = adProvider === 'adsense' && adsenseClient;
---

{gaMeasurementId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaMeasurementId);

      document.addEventListener('click', function (event) {
        const target = event.target instanceof Element
          ? event.target.closest('[data-ga-event]')
          : null;
        if (!target) return;

        const eventName = target.getAttribute('data-ga-event');
        if (!eventName) return;

        gtag('event', eventName, {
          event_category: target.getAttribute('data-ga-category') || 'engagement',
          event_label: target.getAttribute('data-ga-label') || target.getAttribute('href') || undefined,
        });
      });
    </script>
  </>
)}

{loadAdsense && (
  <script
    is:inline
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
    crossorigin="anonymous"
  ></script>
)}
