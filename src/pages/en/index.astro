---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { siteMeta } from '../../data/site-meta';

const title = 'Finance Calculator Hub - Mortgage, Salary, Investing, and AI Costs';
const description = 'Free finance-first calculators for mortgage, salary, compound growth, investing, dividends, and AI API costs, with formulas, examples, and clear limits.';
const keywords = 'finance calculator, mortgage calculator, salary calculator, investment calculator, dividend calculator, AI cost calculator, compound interest calculator';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'mycalcstool',
  url: 'https://mycalcstool.com/en/',
  description,
  inLanguage: 'en',
};

const popular = [
  {
    icon: '🏠',
    title: 'Mortgage Calculator',
    desc: 'Monthly payment, total interest, amortization schedule.',
    href: '/en/mortgage-calculator',
    badge: 'Most Popular',
  },
  {
    icon: '💵',
    title: 'Salary Calculator',
    desc: 'Take-home pay after federal and state taxes.',
    href: '/en/salary-calculator',
    badge: 'Finance',
  },
  {
    icon: '📊',
    title: 'Stock Average Cost',
    desc: 'New average share price after buying more.',
    href: '/en/stock-average-calculator',
    badge: 'Investing',
  },
  {
    icon: '💬',
    title: 'ChatGPT API Cost',
    desc: 'Estimate monthly API cost from tokens, calls, and pricing.',
    href: '/en/chatgpt-api-cost-calculator',
    badge: 'AI Cost',
  },
];

const financeCalcs = [
  { icon: '🏠', title: 'Mortgage Calculator', desc: 'Monthly payment, interest, amortization.', href: '/en/mortgage-calculator' },
  { icon: '💵', title: 'Salary Calculator', desc: 'Take-home pay after federal and state taxes.', href: '/en/salary-calculator' },
  { icon: '📈', title: 'Compound Interest', desc: 'See how savings grow over time.', href: '/en/compound-interest-calculator' },
];

const investingCalcs = [
  { icon: '📊', title: 'Stock Average Cost', desc: 'New average share price after buying more.', href: '/en/stock-average-calculator' },
  { icon: '📉', title: 'Averaging Down', desc: 'Break-even after adding to a lower-priced position.', href: '/en/stock-averaging-down-calculator' },
  { icon: '💹', title: 'Stock Return', desc: 'Profit, loss, and return percentage after costs.', href: '/en/stock-return-calculator' },
  { icon: '💵', title: 'Dividend Calculator', desc: 'Annual and after-tax dividend income.', href: '/en/dividend-calculator' },
  { icon: '🏦', title: 'Dividend Yield', desc: 'Yield from share price and annual dividend.', href: '/en/dividend-yield-calculator' },
  { icon: '🌎', title: 'Foreign Stock FX Return', desc: 'Stock return including exchange rate movement.', href: '/en/foreign-stock-return-calculator' },
  { icon: '📈', title: 'ETF Recurring Investment', desc: 'Future value from monthly ETF investing.', href: '/en/etf-investment-calculator' },
];

const aiCalcs = [
  { icon: '🤖', title: 'AI Token Calculator', desc: 'Estimate tokens from text before budgeting.', href: '/en/ai-token-calculator' },
  { icon: '💬', title: 'ChatGPT API Cost', desc: 'Estimate cost from tokens, calls, and pricing.', href: '/en/chatgpt-api-cost-calculator' },
  { icon: '⚖️', title: 'AI Model Cost Comparison', desc: 'Compare GPT, Claude, and Gemini API costs.', href: '/en/ai-model-cost-comparison' },
];

const featuredPosts = [
  {
    href: '/en/blog/pmi-guide-how-private-mortgage-insurance-works',
    title: 'PMI Guide: What Private Mortgage Insurance Costs and When It Ends',
    desc: 'What PMI is, how it affects monthly payments, and when borrowers can usually remove it.',
    category: 'Money & Finance',
    readTime: '8 min',
  },
  {
    href: '/en/blog/salary-calculator-guide-gross-vs-net-pay',
    title: 'Salary Calculator Guide: Gross Pay vs Net Pay Explained',
    desc: 'What gets deducted from a paycheck and how to estimate take-home income.',
    category: 'Money & Finance',
    readTime: '8 min',
  },
  {
    href: '/en/blog/how-much-house-can-i-afford-guide',
    title: 'How Much House Can I Afford?',
    desc: 'Estimate affordability from income, debt, down payment, and monthly payment assumptions.',
    category: 'Money & Finance',
    readTime: '9 min',
  },
  {
    href: '/en/blog/first-time-homebuyer-guide',
    title: 'First-Time Homebuyer Guide',
    desc: 'Down payment, mortgage math, credit score requirements, and buying power estimates.',
    category: 'Money & Finance',
    readTime: '10 min',
  },
];

const focusCards = [
  {
    title: 'Finance-first calculators',
    desc: 'The primary site path focuses on mortgage, salary, compound growth, investing, dividend, and AI cost decisions rather than a generic tool directory.',
    href: '/en/methodology',
    link: 'Read methodology',
  },
  {
    title: 'Formulas and limits included',
    desc: 'Calculator pages explain the input units, formula, examples, common mistakes, and when the result should be checked against an official source.',
    href: '/en/blog/',
    link: 'Read guides',
  },
  {
    title: 'Corrections are welcome',
    desc: 'Rates, rules, and model prices change. If you find an outdated assumption, send the page URL and source so we can review it.',
    href: '/en/contact',
    link: 'Send correction',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} lang="en" jsonLd={jsonLd} hreflangKo="/">

  <!-- Hero -->
  <div class="text-center mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Finance Calculator Hub</h1>
    <p class="text-gray-500 text-base max-w-2xl mx-auto">
      Browser-based calculators for money decisions, investing scenarios, and AI API cost planning, with formulas and assumptions shown on the page.
    </p>
  </div>

  <section class="mb-8" aria-labelledby="site-focus">
    <h2 id="site-focus" class="sr-only">mycalcstool editorial focus</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {focusCards.map((card) => (
        <article class="card border-primary-100 bg-white">
          <h3 class="font-bold text-gray-800 mb-2">{card.title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-3">{card.desc}</p>
          <a href={card.href} class="text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors">{card.link} →</a>
        </article>
      ))}
    </div>
  </section>

  <AdSlot slot="top" format="horizontal" />

  <!-- Most Popular -->
  <section class="mb-10">
    <h2 class="text-lg font-bold text-gray-700 mb-4">Most Popular Right Now</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {popular.map(calc => (
        <a href={calc.href} class="group bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all p-5 flex flex-col gap-3 no-underline">
          <div class="flex items-start justify-between gap-2">
            <div class="text-4xl leading-none">{calc.icon}</div>
            <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full shrink-0">{calc.badge}</span>
          </div>
          <div>
            <div class="font-bold text-gray-900 text-base group-hover:text-blue-600 transition-colors mb-1">{calc.title}</div>
            <div class="text-sm text-gray-500 leading-relaxed">{calc.desc}</div>
          </div>
          <div class="mt-auto pt-1">
            <span class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 group-hover:gap-2 transition-all">
              Use Calculator <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Finance Calculators -->
  <section class="mb-8">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-base font-bold text-gray-700 flex items-center gap-2">
        <span aria-hidden="true">💰</span> Finance Calculators
      </h2>
      <a href="/en/methodology" class="text-xs font-semibold text-blue-600 hover:text-blue-700 transition-colors">Methodology →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {financeCalcs.map(calc => (
        <a href={calc.href} class="bg-white rounded-xl border border-gray-200 p-4 hover:shadow-md hover:border-blue-200 transition-all group flex flex-col gap-1 no-underline">
          <div class="text-2xl mb-1">{calc.icon}</div>
          <div class="font-semibold text-sm text-gray-800 group-hover:text-blue-600 transition-colors">{calc.title}</div>
          <div class="text-xs text-gray-500">{calc.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Investing Calculators -->
  <section class="mb-8">
    <h2 class="text-base font-bold text-gray-700 mb-4 flex items-center gap-2">
      <span aria-hidden="true">📊</span> Stock &amp; ETF Calculators
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {investingCalcs.map(calc => (
        <a href={calc.href} class="bg-white rounded-xl border border-gray-200 p-4 hover:shadow-md hover:border-blue-200 transition-all group flex flex-col gap-1 no-underline">
          <div class="text-2xl mb-1">{calc.icon}</div>
          <div class="font-semibold text-sm text-gray-800 group-hover:text-blue-600 transition-colors">{calc.title}</div>
          <div class="text-xs text-gray-500">{calc.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- AI Cost Calculators -->
  <section class="mb-8">
    <h2 class="text-base font-bold text-gray-700 mb-4 flex items-center gap-2">
      <span aria-hidden="true">🤖</span> AI Cost Calculators
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {aiCalcs.map(calc => (
        <a href={calc.href} class="bg-white rounded-xl border border-gray-200 p-4 hover:shadow-md hover:border-blue-200 transition-all group flex flex-col gap-1 no-underline">
          <div class="text-2xl mb-1">{calc.icon}</div>
          <div class="font-semibold text-sm text-gray-800 group-hover:text-blue-600 transition-colors">{calc.title}</div>
          <div class="text-xs text-gray-500">{calc.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Editorial Scope -->
  <section class="bg-slate-50 rounded-2xl border border-slate-100 px-6 py-5 mb-10">
    <h2 class="text-base font-bold text-gray-800 mb-3">Current Editorial Scope</h2>
    <p class="text-sm text-gray-600 leading-relaxed">
      During the AdSense review window, mycalcstool is focusing the main navigation on finance, investing, and AI cost calculators.
      General health, date, and unit tools remain available for users who bookmarked them, but they are not promoted from the homepage.
    </p>
  </section>

  <!-- Trust bar -->
  <section class="bg-gray-50 rounded-2xl border border-gray-100 px-6 py-4 mb-10">
    <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center text-sm text-gray-600">
      <span class="flex items-center gap-1.5"><span class="text-green-500 font-bold">✓</span> 100% free, no account needed</span>
      <span class="flex items-center gap-1.5"><span class="text-green-500 font-bold">✓</span> Calculations run in your browser</span>
      <span class="flex items-center gap-1.5"><span class="text-green-500 font-bold">✓</span> Updated for 2026 tax rates</span>
      <span class="flex items-center gap-1.5"><span class="text-green-500 font-bold">✓</span> Mobile-friendly</span>
    </div>
  </section>

  <!-- Featured Blog Posts -->
  <section class="mb-10">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-base font-bold text-gray-700 flex items-center gap-2">
        <span aria-hidden="true">📝</span> Featured Guides
      </h2>
      <a href="/en/blog/" class="text-xs font-semibold text-blue-600 hover:text-blue-700 transition-colors">All articles →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
      {featuredPosts.map(post => (
        <a href={post.href} class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md hover:border-blue-200 transition-all group flex flex-col gap-2 no-underline">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">{post.category}</span>
            <span class="text-xs text-gray-400">{post.readTime} read</span>
          </div>
          <div class="font-semibold text-sm text-gray-800 group-hover:text-blue-600 transition-colors leading-snug">{post.title}</div>
          <div class="text-xs text-gray-500 leading-relaxed">{post.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Contact / Trust footer -->
  <section class="bg-white rounded-2xl border border-gray-100 shadow-sm px-6 py-4">
    <p class="text-sm text-gray-600 leading-relaxed text-center">
      Questions or corrections?
      <a href="/en/about" class="font-semibold text-blue-600 hover:underline mx-1">About</a>·
      <a href="/en/methodology" class="font-semibold text-blue-600 hover:underline mx-1">Methodology</a>·
      <a href={`mailto:${siteMeta.contactEmail}`} class="font-semibold text-blue-600 hover:underline mx-1">{siteMeta.contactEmail}</a>
    </p>
  </section>

</BaseLayout>
