---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { englishBlogPosts } from '../../../data/en-blog-posts';

const title = 'Finance Calculator Guides - Mortgage, Salary, Home Buying';
const description = 'Finance-first guides for mortgage payments, PMI, salary take-home pay, home affordability, and first-time homebuyer planning.';
const keywords = 'finance calculator guides, mortgage guide, salary calculator guide, PMI guide, home affordability guide';
const approvedFinanceSlugs = new Set([
  'pmi-guide-how-private-mortgage-insurance-works',
  'salary-calculator-guide-gross-vs-net-pay',
  'how-much-house-can-i-afford-guide',
  'first-time-homebuyer-guide',
  'tipping-guide',
]);
const posts = englishBlogPosts.filter((post) => approvedFinanceSlugs.has(post.slug));

const featuredFinancePosts = posts.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'mycalcstool Finance Guides',
  description,
  url: 'https://mycalcstool.com/en/blog/',
  inLanguage: 'en',
};
---

<BaseLayout title={title} description={description} keywords={keywords} lang="en" jsonLd={jsonLd}>
  <div class="mb-6">
    <nav class="text-sm text-gray-500 mb-2" aria-label="breadcrumb">
      <ol class="flex items-center gap-1 list-none p-0">
        <li><a href="/en/" class="hover:text-blue-600 transition-colors">Home</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li class="text-gray-700 font-medium" aria-current="page">Blog</li>
      </ol>
    </nav>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Finance Guides</h1>
    <p class="text-gray-500 mt-2">Money-focused explainers that support the mortgage, salary, and home-buying calculators.</p>
  </div>

  <AdSlot slot="top" format="horizontal" />

  <section class="mb-10">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-xl font-bold text-gray-800">Featured Finance Guides</h2>
      <a href="/en/methodology" class="text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors">Methodology →</a>
    </div>
    <div class="space-y-4">
      {featuredFinancePosts.map(post => (
        <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">{post.category}</span>
            <span class="text-xs text-gray-400">{post.readTime}</span>
          </div>
          <a href={post.href} class="block group">
            <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">{post.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{post.description}</p>
          </a>
          <div class="mt-3 flex items-center justify-between">
            <time class="text-xs text-gray-400" datetime={post.date}>
              {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <a href={post.href} class="text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors">Read more →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 rounded-2xl border border-slate-100 px-6 py-5">
    <h2 class="text-lg font-bold text-gray-800 mb-2">How these guides are selected</h2>
    <p class="text-sm text-gray-600 leading-relaxed">
      This index intentionally highlights finance guides that connect directly to active calculators.
      Broader health, date, and utility articles are kept off the main blog index during review so the site has a clearer editorial scope.
    </p>
  </section>
</BaseLayout>
