---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../data/articles.mjs';
import { siteMeta } from '../../data/site-meta';

const title = '금융·생활 이슈 계산 가이드';
const description = '기준금리, 연말정산, AI API 가격처럼 실제 금액 판단이 필요한 이슈를 계산기와 함께 정리합니다.';
const articles = getPublishedArticles('ko');

const articlesUrl = `${siteMeta.url}/articles/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: articlesUrl,
    inLanguage: 'ko',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '홈',
        item: siteMeta.url,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '이슈 계산 가이드',
        item: articlesUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${articlesUrl}${article.slug}/`,
      name: article.title,
    })),
  },
];
---

<BaseLayout title={title} description={description} keywords="금융 이슈, 생활경제, 계산기 가이드, AI 비용" jsonLd={jsonLd}>
  <section class="mb-8">
    <nav class="mb-2 text-sm text-gray-500" aria-label="breadcrumb">
      <ol class="flex list-none items-center gap-1 p-0">
        <li><a href="/" class="transition-colors hover:text-primary-600">홈</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li class="font-medium text-gray-700" aria-current="page">이슈 계산 가이드</li>
      </ol>
    </nav>
    <p class="mb-3 inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-semibold text-slate-700">
      내 금액으로 다시 확인하는 이슈
    </p>
    <h1 class="text-2xl font-black text-slate-950 md:text-4xl">금융·생활 이슈 계산 가이드</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-600 md:text-base">
      뉴스나 정책 변화를 읽고 끝내지 않고, 내 대출·월급·세금·AI 비용에 어떤 숫자로 연결되는지 확인할 수 있도록 정리합니다.
    </p>
  </section>

  <section class="grid grid-cols-1 gap-4">
    {articles.map((article) => (
      <article class="card transition-shadow hover:shadow-md">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-primary-50 px-2.5 py-1 text-xs font-bold text-primary-700">{article.category}</span>
          <time class="text-xs text-gray-400" datetime={article.updatedDate}>업데이트 {article.updatedDate}</time>
        </div>
        <a href={`/articles/${article.slug}/`} class="block no-underline">
          <h2 class="text-xl font-black text-gray-900 transition-colors hover:text-primary-700">{article.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{article.description}</p>
        </a>
        <div class="mt-4 flex flex-wrap gap-2">
          {article.calculatorCtas.map((cta) => (
            <a href={cta.href} class="rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-bold text-primary-700 hover:border-primary-200 hover:bg-primary-50">
              {cta.label}
            </a>
          ))}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
