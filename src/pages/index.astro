---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import siteConfig from '../data/site-config.json';
import { siteMeta } from '../data/site-meta';

const title = '생활비·금융·AI 비용 계산기 허브';
const description = '이사비용, 대출, 연봉, 세금, 복리, 주식·ETF, AI API 비용처럼 실제 지출과 예산 판단에 쓰는 계산기를 공식과 한계까지 함께 제공합니다.';
const keywords = '생활비 계산기, 금융계산기, 이사비용 계산기, 대출계산기, 연봉계산기, 복리계산기, 주식계산기, AI비용계산기';

const categoryColors: Record<string, string> = {
  '금융': 'bg-blue-50 text-blue-700 border-blue-200',
  'AI': 'bg-slate-50 text-slate-700 border-slate-200',
};

const featuredFinance = siteConfig.calculators
  .filter((calculator) => calculator.category === '금융')
  .sort((left, right) => right.priority - left.priority)
  .slice(0, 4);

const stockCalculators = siteConfig.calculators.filter((calculator) =>
  [
    'stock-average-calculator',
    'stock-averaging-down-calculator',
    'stock-return-calculator',
    'dividend-calculator',
    'dividend-yield-calculator',
    'foreign-stock-return-calculator',
    'etf-investment-calculator',
  ].includes(calculator.id)
).slice(0, 4);

const aiCalculators = siteConfig.calculators.filter((calculator) => calculator.category === 'AI');

const decisionLanes = [
  {
    title: '이사비용 먼저 잡기',
    desc: '원룸·아파트 이사 조건을 넣고 견적 상담 전 예산 범위를 확인합니다.',
    href: '/moving-cost-calculator/',
    event: 'home_primary_moving_click',
    label: 'moving cost calculator',
    cta: '이사비용 계산',
    accent: 'border-amber-200 bg-amber-50 text-amber-900',
  },
  {
    title: '대출·소득 계산',
    desc: '대출 이자, 연봉 실수령액, 세금처럼 매달 현금흐름에 영향을 주는 값을 계산합니다.',
    href: '/loan/',
    event: 'home_primary_finance_click',
    label: 'finance calculator',
    cta: '금융 계산 시작',
    accent: 'border-blue-200 bg-blue-50 text-blue-900',
  },
  {
    title: 'AI 사용료 추정',
    desc: '토큰 수, 요청량, 모델 단가를 나눠 API 비용과 월 예산을 빠르게 추정합니다.',
    href: '/chatgpt-api-cost-calculator/',
    event: 'home_primary_ai_click',
    label: 'ai cost calculator',
    cta: 'AI 비용 계산',
    accent: 'border-slate-200 bg-slate-50 text-slate-900',
  },
];

const operatingPrinciples = [
  '계산 결과만 보여주지 않고 입력 기준, 공식, 예외 조건을 함께 적습니다.',
  '바뀔 수 있는 세율, 요율, AI 단가는 정기 점검과 정정 요청 경로를 둡니다.',
  '개인정보가 필요한 상담이나 신청은 외부 페이지에서만 진행되도록 분리합니다.',
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'mycalcstool',
  url: 'https://mycalcstool.com',
  description,
};
---

<BaseLayout title={title} description={description} keywords={keywords} jsonLd={websiteSchema} hreflangEn="/en/">
  <!-- 언어 자동 리다이렉트 (클라이언트 사이드, SEO 무영향) -->
  <script>
    (function () {
      // 크롤러는 리다이렉트하지 않음
      if (/bot|crawler|spider|googlebot|bingbot|slurp|duckduckbot|baidu|yandex/i.test(navigator.userAgent)) return;
      // 이미 /en/ 경로면 리다이렉트 불필요
      if (location.pathname.startsWith('/en')) return;
      // 사용자가 수동으로 한국어를 선택한 경우 리다이렉트하지 않음
      if (localStorage.getItem('preferred-lang') === 'ko') return;
      // 브라우저 언어가 한국어가 아니면 /en/으로 이동
      const lang = navigator.language || '';
      if (!lang.startsWith('ko')) {
        location.replace('/en/');
      }
    })();
  </script>

  <section class="mb-8 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="grid gap-0 md:grid-cols-[1.08fr_0.92fr]">
      <div class="p-6 md:p-8">
        <p class="mb-3 inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-semibold text-slate-700">
          비용 판단을 먼저 끝내는 계산기
        </p>
        <h1 class="text-3xl font-black tracking-tight text-slate-950 md:text-5xl">
          생활비·금융·AI 비용 계산기 허브
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 md:text-lg">
          이사비용, 대출, 연봉, 투자, AI API 비용처럼 실제 돈이 움직이는 결정을 계산합니다.
          결과값만 던지지 않고 공식, 가정, 한계까지 같이 보여줍니다.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/moving-cost-calculator/"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-2xl bg-slate-950 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
            data-ga-event="home_primary_moving_click"
            data-ga-category="homepage"
            data-ga-label="hero moving calculator"
          >
            이사비용부터 계산하기
            <span aria-hidden="true" class="ml-1">→</span>
          </a>
          <a
            href="/loan/"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 transition-colors hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
            data-ga-event="home_primary_finance_click"
            data-ga-category="homepage"
            data-ga-label="hero loan calculator"
          >
            금융 계산
          </a>
          <a
            href="/chatgpt-api-cost-calculator/"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 transition-colors hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
            data-ga-event="home_primary_ai_click"
            data-ga-category="homepage"
            data-ga-label="hero ai cost calculator"
          >
            AI 비용
          </a>
          <a
            href="/methodology"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 transition-colors hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
          >
            계산 기준 보기
          </a>
        </div>
      </div>
      <aside class="border-t border-slate-200 bg-slate-950 p-6 text-white md:border-l md:border-t-0 md:p-8" aria-label="계산기 특징">
        <p class="text-sm font-semibold text-slate-300">계산 전에 확인할 것</p>
        <div class="mt-5 space-y-4">
          <div>
            <p class="text-4xl font-black tabular-nums">3</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-300">생활비, 금융, AI 비용을 나눠서 보고 필요한 계산기만 빠르게 선택합니다.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-sm font-bold text-amber-200">결과는 참고용입니다</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">
              실제 견적, 세금, 이자, API 요금은 조건과 시점에 따라 달라질 수 있습니다.
              계산 후 기준과 한계를 함께 확인하세요.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="mb-8" aria-labelledby="decision-lanes">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="decision-lanes" class="text-2xl font-black text-slate-900">자주 쓰는 비용 계산</h2>
        <p class="mt-1 text-sm text-slate-500">이사, 월 현금흐름, AI 사용료처럼 바로 비교하기 좋은 계산기입니다.</p>
      </div>
      <a href="/contact" class="text-sm font-semibold text-primary-600 hover:text-primary-700">오류·정정 요청 →</a>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {decisionLanes.map((lane) => (
        <a
          href={lane.href}
          class={`block rounded-3xl border p-5 no-underline transition-shadow duration-200 hover:shadow-md ${lane.accent}`}
          data-ga-event={lane.event}
          data-ga-category="homepage"
          data-ga-label={lane.label}
        >
          <h3 class="text-lg font-black">{lane.title}</h3>
          <p class="mt-2 min-h-[4.5rem] text-sm leading-relaxed opacity-80">{lane.desc}</p>
          <p class="mt-4 text-sm font-black">{lane.cta} →</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 상단 광고 -->
  <AdSlot slot="top" format="horizontal" />

  <section class="mb-8" aria-labelledby="life-cost-tools">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-black text-slate-900" id="life-cost-tools">생활 비용 계산</h2>
      <p class="text-sm text-slate-500">견적을 받기 전 대략적인 예산 범위를 먼저 확인하세요.</p>
    </div>
    <a
      href="/moving-cost-calculator/"
      class="block rounded-3xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-6 no-underline transition-colors duration-200 hover:border-amber-300"
      aria-label="이사비용 계산기 바로가기"
      data-ga-event="home_primary_moving_click"
      data-ga-category="homepage"
      data-ga-label="life cost moving card"
    >
      <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="mb-3 inline-flex rounded-full border border-amber-200 bg-white px-3 py-1 text-xs font-bold text-amber-800">
            견적 상담 전 예산 확인
          </p>
          <h3 class="text-2xl font-black text-slate-900">이사비용 계산기</h3>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600">
            원룸·아파트 이사 유형, 평수, 거리, 층수, 포장 방식, 날짜 조건을 입력해 예상 비용 범위를 봅니다.
            개인정보는 받지 않고, 실제 상담은 외부 페이지에서만 진행합니다.
          </p>
        </div>
        <div class="rounded-2xl bg-slate-950 px-5 py-3 text-center text-sm font-black text-white">
          예상 비용 계산 →
        </div>
      </div>
    </a>
  </section>

  <section class="mb-8" aria-labelledby="featured-finance">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-xl font-black text-slate-900" id="featured-finance">현금흐름 금융 계산</h2>
      <a href="/methodology" class="text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors">계산 기준 보기 →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {featuredFinance.map(calc => (
        <a
          href={calc.path}
          class="card hover:border-primary-200 transition-colors duration-200 group cursor-pointer no-underline"
          aria-label={`${calc.name} 바로가기`}
        >
          <div class="flex items-start gap-3">
            <span class="text-3xl" role="img" aria-label={calc.name}>{calc.icon}</span>
            <div class="flex-1 min-w-0">
              <div class="mb-2">
                <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${categoryColors[calc.category]}`}>
                  {calc.category}
                </span>
              </div>
              <h3 class="font-semibold text-gray-800 group-hover:text-primary-600 transition-colors">
                {calc.name}
              </h3>
              <p class="text-sm text-gray-500 mt-1 leading-snug">
                {calc.description}
              </p>
            </div>
          </div>
          <div class="mt-3 text-sm font-medium text-primary-600 group-hover:text-primary-700 flex items-center gap-1">
            계산하기
            <span aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-8" aria-labelledby="stock-tools">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-xl font-black text-slate-900" id="stock-tools">주식·ETF 계산기</h2>
      <p class="text-sm text-gray-500">종목 추천 없이 입력값 기준으로만 계산합니다.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {stockCalculators.map(calc => (
        <a
          href={calc.path}
          class="card hover:border-primary-200 transition-colors duration-200 group cursor-pointer no-underline"
          aria-label={`${calc.name} 바로가기`}
        >
          <div class="flex items-start gap-3">
            <span class="text-3xl" role="img" aria-label={calc.name}>{calc.icon}</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-gray-800 group-hover:text-primary-600 transition-colors">{calc.name}</h3>
              <p class="text-sm text-gray-500 mt-1 leading-snug">{calc.description}</p>
            </div>
          </div>
          <div class="mt-3 text-sm font-medium text-primary-600 group-hover:text-primary-700 flex items-center gap-1">
            계산하기
            <span aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-8" aria-labelledby="ai-tools">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-xl font-black text-slate-900" id="ai-tools">AI 비용 계산기</h2>
      <p class="text-sm text-gray-500">토큰·요청 수·모델 단가 기준으로 비용을 추정합니다.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {aiCalculators.map(calc => (
        <a
          href={calc.path}
          class="card hover:border-primary-200 transition-colors duration-200 group cursor-pointer no-underline"
          aria-label={`${calc.name} 바로가기`}
          data-ga-event={calc.id === 'chatgpt-api-cost-calculator' ? 'home_primary_ai_click' : 'home_ai_card_click'}
          data-ga-category="homepage"
          data-ga-label={calc.id}
        >
          <div class="flex items-start gap-3">
            <span class="text-3xl" role="img" aria-label={calc.name}>{calc.icon}</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-gray-800 group-hover:text-primary-600 transition-colors">{calc.name}</h3>
              <p class="text-sm text-gray-500 mt-1 leading-snug">{calc.description}</p>
            </div>
          </div>
          <div class="mt-3 text-sm font-medium text-primary-600 group-hover:text-primary-700 flex items-center gap-1">
            계산하기
            <span aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="card mb-8 bg-slate-50 border-slate-100" aria-labelledby="current-scope">
    <h2 id="current-scope" class="text-xl font-black text-slate-900 mb-3">계산 기준과 한계</h2>
    <p class="text-sm text-gray-700 leading-relaxed mb-3">
      mycalcstool은 계산 결과와 함께 입력 기준, 공식, 예외 조건을 함께 보여주는 무료 계산기 서비스입니다.
      같은 금액처럼 보여도 실제 부담은 날짜, 요율, 환율, 단가, 추가 조건에 따라 달라질 수 있으므로 결과를 참고값으로 확인하세요.
    </p>
    <ul class="list-disc pl-5 text-sm text-gray-700 leading-relaxed space-y-1">
      {operatingPrinciples.map((principle) => (
        <li>{principle}</li>
      ))}
    </ul>
  </section>

  <!-- 사이트 소개 섹션 -->
  <section class="card bg-primary-50 border-primary-100 mt-8">
    <h2 class="text-lg font-bold text-primary-800 mb-3">mycalcstool 소개</h2>
    <p class="text-gray-700 leading-relaxed text-sm">
      {siteMeta.name}은 금융 계산기를 중심으로 운영하는 무료 온라인 계산기 서비스입니다.
      모든 계산은 브라우저에서 직접 처리되며, 계산 기준과 문의 경로는
      <a href="/methodology" class="font-semibold text-primary-700 hover:underline"> 계산 기준</a>,
      <a href="/stock-average-calculator/" class="font-semibold text-primary-700 hover:underline"> 주식·ETF 계산기</a>,
      <a href="/contact" class="font-semibold text-primary-700 hover:underline"> 문의하기</a> 페이지에서 확인할 수 있습니다.
    </p>
  </section>
</BaseLayout>
